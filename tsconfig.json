
{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",                               
    "rootDir": "./src",
    "outDir": "./dist",  
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": ["src/**/*","src/interfaces/index.d.ts"],
  "exclude": ["node_modules","dist"]
}