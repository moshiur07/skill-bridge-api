
{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",                               
    "rootDir": "./",
    "outDir": "./dist",  
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
  },
  "include": ["src","prisma.config.ts","src/interfaces/index.d.ts"],
  "exclude": ["node_modules","dist"]
}